{
  "name": "factutrust-web",
  "version": "1.0.0",
  "description": "InstaFact - Plateforme de gestion commerciale intelligente",
  "scripts": {
    "ng": "ng",
    "start": "set CHOKIDAR_USEPOLLING=1 && ng serve --poll=2000",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "set CHOKIDAR_USEPOLLING=1 && ng build --watch --poll=2000 --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "docs:screenshots": "playwright test capture-screenshots --project=chromium",
    "docs:partnership-video": "playwright test partnership-expert-comptable-video --config=playwright.partnership-video.config.ts --project=chromium",
    "test:e2e:selenium": "ts-node node_modules/jasmine/bin/jasmine.js e2e/registration.selenium.spec.ts",
    "install:playwright": "npx playwright install",
    "theme:import": "node ../../../scripts/import-pluto-theme.js",
    "theme:import-chain": "node ../../../scripts/import-chain-theme.js",
    "lint": "ng lint",
    "virtual-street:build-glbs": "node scripts/generate-facade-glbs.mjs",
    "virtual-street:build-textures": "node scripts/generate-facade-textures.mjs",
    "virtual-street:build-assets": "npm run virtual-street:build-textures && npm run virtual-street:build-glbs",
    "vendor:draco": "node scripts/copy-draco-decoder-to-assets.mjs",
    "validate:facade-glb": "node scripts/validate-facade-glbs.mjs",
    "quality:gate": "npm run virtual-street:build-assets && npm run validate:facade-glb && npm run build:prod"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/router": "^18.2.14",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@lucide/angular": "^1.17.0",
    "@ng-bootstrap/ng-bootstrap": "^17.0.1",
    "@primeng/themes": "^21.0.4",
    "@primeuix/themes": "^2.0.3",
    "@types/three": "^0.161.2",
    "bootstrap": "^5.3.8",
    "camera-controls": "^2.8.3",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "marked": "^9.1.6",
    "ngx-markdown": "^18.1.0",
    "primeicons": "^6.0.0",
    "primeng": "^18.0.2",
    "rxjs": "~7.8.0",
    "three": "^0.161.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.14",
    "@playwright/test": "^1.57.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.0.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jasmine": "^5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "selenium-webdriver": "^4.15.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.0",
    "typescript": "~5.5.4"
  }
}
