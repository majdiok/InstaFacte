{
  "ConnectionStrings": {
    "MasterConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FactuTrust_Master;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "DefaultTenantConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FactuTrust_Tenant_Default;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "FactuTrust",
    "Audience": "FactuTrust-API",
    "ExpiryMinutes": 15
  },
  "AllowedOrigins": "http://localhost:4200,https://localhost:4200,http://localhost:4300,https://localhost:4300",
  "App": {
    "FrontendBaseUrl": "http://localhost:4200"
  },
  "FirmCollaboratorAttachments": {
    "BasePath": "App_Data/attachments"
  },
  "TenantMigrations": {
    "ApplyOnStartup": true,
    "ApplyOnlyToMissingMigrations": true
  },
  "TenantProvisioning": {
    "Strategy": "TemplateClone",
    "TemplateDatabaseName": "FactuTrust_Tenant_Template",
    "CleanupOrphanDatabasesOnFailure": true
  },
  "Accounting": {
    "BrouillardEnabled": true,
    "IncludeBrouillardInReports": true,
    "ManualReversalEnabled": true,
    "DossierImportEnabled": true,
    "MonthlyDeclarationV2Enabled": true,
    "NctStatementsEnabled": true,
    "FodecRatePercent": 1.0,
    "TclRatePercent": 0.2,
    "AccountReplacementEnabled": true,
    "JournalCatalogEnabled": true,
    "PreClosingControlsEnabled": true,
    "UnletteredAgeThresholdDays": 90,
    "InventoryAssistantEnabled": true,
    "DefinitiveLockEnabled": true,
    "BudgetingEnabled": true,
    "FiscalEmailRemindersEnabled": true,
    "DeclarationScheduleSyncEnabled": true,
    "EffetDeCommerceEnabled": true,
    "ThirdPartyDirectoryEnabled": true,
    "AccountingHealthEnabled": true,
    "PayrollTreasuryLinkEnabled": true,
    "PayrollEmployeeAuxiliaryEnabled": true,
    "PayrollCnssRemittanceEnabled": true,
    "PayrollSocialFundsEnabled": true,
    "PayrollMealVouchersEnabled": true,
    "PayrollInKindBenefitsEnabled": true,
    "PayrollEmployeeLoansEnabled": true,
    "PayrollGarnishmentsEnabled": true,
    "PayrollStatutorySickLeaveEnabled": true,
    "PayrollStatutoryMaternityLeaveEnabled": true,
    "PayrollStatutoryPaternityLeaveEnabled": true,
    "PayrollTerminationIndemnityEnabled": true,
    "PayrollHrDocumentsEnabled": true,
    "PayrollAnnualBonusesEnabled": true,
    "PayrollPublicHolidaysEnabled": true,
    "PayrollCivpEnhancementsEnabled": true,
    "PayrollCnssCeilingsEnabled": true,
    "PayrollLegalPresetsHistoryEnabled": true
  },
  "Features": {
    "FixedAssets": {
      "Enabled": true
    },
    "AutoCashFromInvoicePayment": true,
    "AutoCashFromSupplierPayment": true,
    "Storefront": {
      "Enabled": true,
      "CurrentTermsVersion": "1.0.0",
      "PublicMediaFolder": "public-storefronts",
      "MaxPublishedStorefronts": 5000,
      "ProjectionPollIntervalSeconds": 10,
      "OrderSubmissionRequiresCaptcha": true
    },
    "AccountingFirms": {
      "Enabled": true
    },
    "FirmGovernance": {
      "Enabled": true,
      "DefaultHourlyCostRate": 50
    },
    "FirmFiscalOps": {
      "Enabled": true
    }
  },
  "AiExport": {
    "Validation": {
      "Enabled": true,
      "ThrowOnError": false,
      "MaxIssuesLogged": 10
    },
    "PowerPoint": {
      "EnhancedRenderingEnabled": true,
      "SemanticSectionSlidesEnabled": true,
      "MarkdownTableExtractionEnabled": true,
      "ExtendedThemeLibraryEnabled": true,
      "TemplateHybridEnabled": true,
      "HybridThemeMinId": 3,
      "RequireAttributionSlide": true
    }
  },
  "Forecasting": {
    "Enabled": true,
    "DefaultLeadTimeDays": 7,
    "DefaultHorizonDays": 30,
    "MinHistoryMonthsForHoltWinters": 24,
    "MinHistoryPointsForHolt": 6,
    "ConfidenceZ": 1.96,
    "CacheTtlMinutes": 60,
    "RecomputeHourTunis": 2,
    "PromotionScanDayOfWeek": "Monday",
    "PromotionScanHourTunis": 3,
    "BackgroundRecomputeEnabled": true,
    "PromotionDetectorEnabled": true,
    "AbcAClassThreshold": 80.0,
    "AbcBClassThreshold": 95.0,
    "XyzXClassThreshold": 0.5,
    "XyzYClassThreshold": 1.0,
    "DormantProductDays": 90,
    "OverstockMultiplier": 1.2,
    "MaxRecomputeRunsPerDay": 2,
    "SeasonalFactors": {
      "Alimentaire": { "Ramadan": 1.6, "AidAlFitr": 1.4, "AidAlAdha": 1.5, "RentreeScolaire": 1.05 },
      "Textile": { "SoldesEte": 1.4, "SoldesHiver": 1.4, "RentreeScolaire": 1.3, "AidAlFitr": 1.3 },
      "Cadeaux": { "AidAlFitr": 2.0, "AidAlAdha": 1.6, "Mouled": 1.3, "RasElAmHijri": 1.2 },
      "Fournitures": { "RentreeScolaire": 2.2 },
      "Boissons": { "Ramadan": 1.3, "Ete": 1.2 },
      "Patisserie": { "Ramadan": 1.8, "AidAlFitr": 1.7, "Mouled": 1.4 }
    },
    "Replenishment": {
      "AutoCreatePurchaseOrders": true,
      "MultiLevelApproval": true,
      "RealTimeNotifications": true,
      "KpiDashboard": true,
      "UrgencyThresholdDays": 3,
      "DefaultServiceLevelZ": 1.65,
      "MaxPrepareBatchSize": 200,
      "UndoWindowHours": 24
    }
  },
  "ExternalApis": {
    "Unsplash": {
      "AccessKey": "",
      "BaseUrl": "https://api.unsplash.com"
    },
    "GoogleCustomSearch": {
      "ApiKey": "",
      "SearchEngineId": ""
    }
  },
  "ScreenAnalysis": {
    "Enabled": true,
    "EnhancedPromptsEnabled": true,
    "EnhancedPayloadsEnabled": true,
    "DeduplicateContextInMessage": true,
    "ServerEnrichmentEnabled": true,
    "PostProcessToolsEnabled": true,
    "ForceFinalSynthesisEnabled": true,
    "Temperature": 0.15,
    "MaxTokens": 3072,
    "MaxToolCallRounds": 2,
    "MaxAnalysisSummaryChars": 8192,
    "ForceDashboardForScreens": [
      "accounting-income-statement",
      "accounting-balance",
      "accounting-balance-sheet",
      "dashboard",
      "cash-desk",
      "invoice-list"
    ],
    "PerScreenOverrides": {
      "accounting-income-statement": { "EnhancedPrompt": true, "EnhancedPayload": true },
      "accounting-ledger": { "EnhancedPrompt": true, "EnhancedPayload": true },
      "cash-desk": { "EnhancedPrompt": true, "EnhancedPayload": true }
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "DefaultModel": "qwen2.5:3b-instruct",
    "InvoiceImportModel": "qwen2.5:7b-instruct",
    "InvoiceImportVisionModel": "llava",
    "InvoiceImportVisionMinOcrChars": 80,
    "InvoiceImportVisionOnEmptyOcr": true,
    "ImportMaxOutputTokens": 1536,
    "ImportLlmTimeoutSeconds": 180,
    "TimeoutSeconds": 300,
    "MaxConcurrentGenerations": 1,
    "ChatStreamInactivityTimeoutSeconds": 120,
    "MaxTokens": 2048,
    "NumCtx": 16384,
    "NumCtxMin": 4096,
    "FixedChatNumCtx": 8192,
    "CpuFixedChatNumCtx": 6144,
    "CpuFixedChatNumCtxCeiling": 8192,
    "CpuNumBatch": 128,
    "UseCompactChatPromptOnCpu": true,
    "CpuMaxToolCallRounds": 1,
    "NumThread": null,
    "DeferUserMessagePersist": true,
    "LoadPartialConversationMessages": true,
    "ConversationLoadMessageSlack": 2,
    "EnableToolIntentRouting": true,
    "EnableParallelDbTools": true,
    "MaxParallelDbTools": 3,
    "EnableReadOnlyToolCache": true,
    "ReadOnlyToolCacheSeconds": 45,
    "NumBatch": 256,
    "AdaptiveContextEnabled": true,
    "EnableParallelToolCalls": true,
    "EnableDeterministicToolCache": true,
    "Temperature": 0.2,
    "Seed": 42,
    "MaxToolCallRounds": 2,
    "ForceFinalSynthesis": true,
    "MinAssistantTextCharsForCompleteResponse": 80,
    "DeterministicFallbackEnabled": true,
    "ConversationalFastPathEnabled": true,
    "RedactInternalToolNamesEnabled": true,
    "ForceFinalSynthesisOnlyAfterTools": true,
    "SalesTodayPresetShortcutEnabled": true,
    "SalesMonthPresetShortcutEnabled": true,
    "ComplianceCheckShortcutEnabled": true,
    "DefaultRankingRows": 50,
    "MaxToolResultChars": 8000,
    "MaxContextMessages": 10,
    "AvailabilityCacheSeconds": 5,
    "ModelListCacheSeconds": 60,
    "SystemPromptCacheMinutes": 60,
    "SseHeartbeatIntervalSeconds": 15,
    "EnableMutationTools": true,
    "EnableStudioAiPlanPreview": true,
    "EnableStudioAiModifyTools": true,
    "EnableStudioReportPdf": true,
    "EnableStudioAiViewTools": true,
    "UseCompactImportPrompt": true,
    "KeepAliveEnabled": true,
    "KeepAliveIntervalMinutes": 10,
    "KeepAliveMinutes": 60,
    "KeepVisionModelWarm": false
  },
  "Channels": {
    "Enabled": true,
    "WhatsAppEnabled": true,
    "MaxInboundMessageLength": 4000,
    "LinkCodeTtlMinutes": 10,
    "LinkCodeMaxAttempts": 5,
    "MaxOutboundMessageChars": 3500,
    "InboundProcessingTimeoutSeconds": 300,
    "FiscalWhatsAppRemindersEnabled": false,
    "NodeExecutablePath": "node",
    "BridgeDirectory": "",
    "SessionDirectory": "",
    "AutoStart": true,
    "SendTimeoutSeconds": 30,
    "RestartMinBackoffSeconds": 5,
    "RestartMaxBackoffSeconds": 300
  },
  "OpenRouter": {
    "DefaultBaseUrl": "https://openrouter.ai/api/v1",
    "HttpReferer": "http://localhost:4200",
    "AppTitle": "InstaFact",
    "TimeoutSeconds": 120,
    "ModelListCacheSeconds": 120
  },
  "Bootstrap": {
    "PlatformAdmin": {
      "Email": "",
      "Password": ""
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Process",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "FactuTrust.API"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/factutrust-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Seq": {
    "Enabled": false,
    "ServerUrl": "http://localhost:5341",
    "ApiKey": ""
  },
  "AllowedHosts": "*"
}
