<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>FactuTrust.API</RootNamespace>
    <AssemblyName>FactuTrust.API</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FactuTrust.Application\FactuTrust.Application.csproj" />
    <ProjectReference Include="..\FactuTrust.Domain\FactuTrust.Domain.csproj" />
    <ProjectReference Include="..\FactuTrust.Infrastructure\FactuTrust.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FactuTrust.API.Tests" />
  </ItemGroup>

  <!-- Pont WhatsApp (Node) : copié à la sortie SANS node_modules ni la session persistée.
       On PURGE d'abord les items par défaut du SDK Web (qui capteraient node_modules/**/*.json —
       des milliers de fichiers) puis on ré-inclut une seule fois le pont avec copie.
       `npm ci` doit être exécuté une fois dans le dossier de sortie (documenté). -->
  <ItemGroup>
    <Content Remove="WhatsAppBridge\**" />
    <None Remove="WhatsAppBridge\**" />
    <None Include="WhatsAppBridge\**\*"
          Exclude="WhatsAppBridge\node_modules\**;WhatsAppBridge\whatsapp-session\**;WhatsAppBridge\.wwebjs_auth\**;WhatsAppBridge\.wwebjs_cache\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Remove="CursorSdkBridge\**" />
    <None Remove="CursorSdkBridge\**" />
    <None Include="CursorSdkBridge\**\*"
          Exclude="CursorSdkBridge\node_modules\**;CursorSdkBridge\scratch\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Chemin SOURCE du pont, baké dans l'assembly : en DEV (machine de build = machine d'exécution),
       BridgeDirectoryResolver peut réutiliser le node_modules du dossier source (non copié à la
       sortie). En production ce chemin n'existe pas → repli automatique sur le dossier de sortie. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WhatsAppBridgeSourceDirectory</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)\WhatsAppBridge</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CursorSdkBridgeSourceDirectory</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)\CursorSdkBridge</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Authentication & Authorization -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.1" />
    
    <!-- API Documentation -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    
    <!-- Rate Limiting (built-in .NET 8) -->
    <!-- No package needed, uses Microsoft.AspNetCore.RateLimiting -->
    
    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.0" />
    
    <!-- CORS, Security Headers -->
    <!-- Built-in to ASP.NET Core -->
    
    <!-- Serilog for ASP.NET Core -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="6.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="2.3.0" />
    <PackageReference Include="Serilog.Enrichers.Process" Version="2.0.2" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="3.1.0" />

    <!-- Hangfire — Lot B5 : recurring + queued background jobs -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Hangfire.Core" Version="1.8.14" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.14" />
    
    <!-- EF Core Design (required for migrations tooling) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
