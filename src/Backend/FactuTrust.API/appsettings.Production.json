{
  "Ollama": {
    "EnableMutationTools": true,
    "EnableStudioSystemGeneration": true,
    "EnableStudioAiPlanPreview": true,
    "EnableStudioAiModifyTools": true,
    "EnableStudioAiViewTools": true,
    "_commentStudioReports": "États sur les tables réelles : désactivés tant que la recette (§7.4 de docs/developer/studio-ai-assistant-qa.md) n'est pas passée, notamment le contrôle croisé au millime contre /reports/sales-by-line. EnableStudioSqlSourceGuard exige en plus le runbook d'impact sur les fenêtres existantes.",
    "EnableStudioSqlReportEngine": true,
    "EnableStudioAiReportTools": true,
    "EnableStudioReportShortcut": true,
    "EnableStudioSqlSourceGuard": true,
    "InvoiceImportModel": "qwen2.5:7b-instruct",
    "InvoiceImportVisionModel": "gemma3:4b",
    "InvoiceImportVisionOnImages": true,
    "ImportMaxOutputTokens": 1536,
    "ImportLlmTimeoutSeconds": 180,
    "KeepAliveEnabled": true,
    "EnableParallelDbTools": true,
    "MaxParallelDbTools": 3,
    "EnableReadOnlyToolCache": true,
    "ReadOnlyToolCacheSeconds": 45,
    "DeferUserMessagePersist": true,
    "EnableToolIntentRouting": true,
    "CpuFixedChatNumCtx": 6144,
    "CpuFixedChatNumCtxCeiling": 8192,
    "CpuNumBatch": 128,
    "UseCompactChatPromptOnCpu": true,
    "CpuMaxToolCallRounds": 1,
    "NumThread": null
  },
  "TenantMigrations": {
    "_comment": "En production, les migrations tenant ne s'appliquent PAS au boot : elles passent par POST /api/platform/migrations (contrôlé) et par TenantMigrationGuard à la volée.",
    "ApplyOnStartup": false,
    "ApplyOnlyToMissingMigrations": true
  },
  "Accounting": {
    "PayrollTreasuryLinkEnabled": true,
    "PayrollEmployeeAuxiliaryEnabled": true,
    "PayrollCnssRemittanceEnabled": true,
    "PayrollSocialFundsEnabled": true,
    "PayrollMealVouchersEnabled": true,
    "PayrollInKindBenefitsEnabled": true,
    "PayrollEmployeeLoansEnabled": true,
    "PayrollGarnishmentsEnabled": true,
    "PayrollStatutorySickLeaveEnabled": true,
    "PayrollStatutoryMaternityLeaveEnabled": true,
    "PayrollStatutoryPaternityLeaveEnabled": true,
    "PayrollTerminationIndemnityEnabled": true,
    "PayrollHrDocumentsEnabled": true,
    "PayrollAnnualBonusesEnabled": true,
    "PayrollPublicHolidaysEnabled": true,
    "PayrollCivpEnhancementsEnabled": true,
    "PayrollCnssCeilingsEnabled": true,
    "PayrollLegalPresetsHistoryEnabled": true
  },
  "TreasuryForecast": {
    "_comment": "Trésorerie prévisionnelle par IA — désactivée en production tant que la migration tenant n'est pas appliquée et le module recetté. Basculer conjointement avec le flag front treasuryCashForecast.",
    "Enabled": true,
    "BackgroundRecomputeEnabled": true,
    "Ai": {
      "Enabled": true
    }
  },
  "ProductOnboarding": {
    "Enabled": true,
    "CatalogVersion": 1
  },
  "Features": {
    "AutoCashFromInvoicePayment": true,
    "AutoCashFromSupplierPayment": true,
    "PosRegisterSessions": true,
    "FirmGovernance": {
      "EnableFirmInternalPayroll": true,
      "AutoProvisionPayrollOnCollaboratorCreate": true
    },
    "AccountingFirms": {
      "Enabled": true,
      "AiAccountingEnabled": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
