        { "key": "date_prevue", "label": "Date prévue", "type": "date", "required": true },
        { "key": "cout", "label": "Coût", "type": "money", "config": { "currency": "TND" } },
        { "key": "commentaire", "label": "Commentaire", "type": "multilinetext" }
