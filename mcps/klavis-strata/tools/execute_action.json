      },
      "action_name": {
        "type": "string",
        "description": "The name of the action/operation to execute"
      },
      "path_params": {
        "type": "string",
        "description": "JSON string containing path parameters for the action"
      },
      "query_params": {
        "type": "string",
        "description": "JSON string containing query parameters for the action"
      },
      "body_schema": {
        "type": "string",
        "description": "JSON string containing request body for actions",
        "default": "{}"
      },
      "include_output_fields": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional but strongly recommended when you know the response_schema of this action from previous tool calls: Array of field paths to include in the response. Only these fields will be returned. Use dot notation for nested fields (e.g., \"author.displayName\")."
      },
      "maximum_output_characters": {
        "type": "integer",
        "description": "Optional: Maximum number of characters to return in the response. If the response exceeds this limit, it will be truncated. Prefer include_output_fields over this."
      }
    }
